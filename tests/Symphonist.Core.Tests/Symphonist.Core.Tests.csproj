<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Symphonist.Core\Symphonist.Core.csproj" />
    <ProjectReference Include="..\..\src\Symphonist.Integrations\Symphonist.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config/orders.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/projects/orders.example.yaml" Link="Config/orders.example.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/projects/orders-github.example.yaml" Link="Config/orders-github.example.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>