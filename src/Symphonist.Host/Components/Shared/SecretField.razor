@* A secret's state and a password field that writes its value straight to the secret store. The value never enters the
   render tree (the input is not bound) and is dropped as soon as Save secret is clicked: the input is replaced by an
   empty one, so the browser forgets it too. *@
<div class="secret-field" data-secret="@Name">
    <label for="@InputId">Value of <code>@Name</code></label>
    <span class="secret-state" id="@($"{InputId}-state")">@State</span>
    <div class="secret-row">
        <input @key="generation" id="@InputId" type="password" autocomplete="new-password" spellcheck="false"
               aria-describedby="@($"{InputId}-state")" @onchange="Capture" />
        <button type="button" class="button" @onclick="Save">Save secret</button>
    </div>
    @if (error is not null)
    {
        <p class="field-error" role="alert">@error</p>
    }
</div>

@code {
    private string? value;
    private int generation;
    private string? error;

    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>"Set", "Not set" or "Set by environment variable".</summary>
    [Parameter, EditorRequired] public string State { get; set; } = "";

    /// <summary>Stores (name, value); returns why it failed, or null.</summary>
    [Parameter, EditorRequired] public Func<string, string, string?> OnSave { get; set; } = default!;

    private string InputId => $"secret-{Name}";

    private void Capture(ChangeEventArgs e) => value = e.Value as string;

    private void Save()
    {
        var entered = value;
        value = null;
        generation++; // a new, empty input
        error = string.IsNullOrWhiteSpace(entered) ? "Type the secret value first" : OnSave(Name, entered);
    }
}
