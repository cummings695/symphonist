@using Symphonist.Core.Risk
@using Symphonist.Core.Agents
@* The filtered board's project heading, placed after the board's <h1> (which holds the name and stays one element). *@
<div class="project" data-project="@Project.Id">
    <div class="project-row">
        <span class="badge">@Project.Source</span>
        <span class="badge" title="The risk reviewer's mode for this project">Reviewer: @Project.Review.ToString().ToLowerInvariant()</span>
        @if (Project.Isolation == Isolation.Host)
        {
            <span class="badge badge-caution" title="The agent runs directly on this machine, not in a container">host mode</span>
        }
        @if (Project.Paused)
        {
            <span class="badge badge-paused">Paused</span>
        }
        @if (Agreement().Any())
        {
            <p class="project-agreement" aria-label="Reviewer agreement with your decisions">
                @foreach (var a in Agreement())
                {
                    <span data-agreement="@a.StageId">@Describe(a)</span>
                }
            </p>
        }
        <a class="button button-quiet" href="@($"/projects/{Uri.EscapeDataString(Project.Id)}/setup")" aria-label="@($"Set up {Project.Name}")">Setup</a>
        @if (Project.Paused)
        {
            <button type="button" class="button" aria-label="@($"Resume {Project.Name}")" @onclick="OnTogglePause">Resume</button>
        }
        else
        {
            <button type="button" class="button button-quiet" aria-label="@($"Pause {Project.Name}")" @onclick="OnTogglePause">Pause</button>
        }
    </div>
    @foreach (var pause in Project.UsagePauses ?? [])
    {
        <p class="project-usage-pause" data-usage-pause="@pause.Key">
            <span class="badge badge-paused">Paused: @UsageLimitText.Describe(pause.Key, pause.ResetsAt, Zone, Now)</span>
            <button type="button" class="button button-quiet" aria-label="@($"Resume {UsageLimits.ProviderName(pause.Key)} jobs now")"
                    @onclick="() => OnResumeUsage.InvokeAsync(pause.Key)">Resume</button>
        </p>
    }
    @if (Project.Problem is { Length: > 0 } problem)
    {
        <p class="project-problem"><strong>Problem:</strong> @problem</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public BoardProject Project { get; set; } = default!;

    [Parameter] public EventCallback OnTogglePause { get; set; }

    /// <summary>Lifts a provider's usage-limit pause by its key.</summary>
    [Parameter] public EventCallback<string> OnResumeUsage { get; set; }

    /// <summary>The time zone the reset time is shown in, and the current time (to leave out today's date).</summary>
    [Parameter] public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Local;

    [Parameter] public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    private IEnumerable<StageAgreement> Agreement() =>
        (Project.Agreement ?? []).Where(a => a.Decided > 0 || a.AutoApproved > 0);

    private static string Describe(StageAgreement a) =>
        $"{a.StageId}: agrees {a.Agreed}/{a.Decided}"
        + (a.FalseLows > 0 ? $" · {a.FalseLows} low-risk call(s) sent back" : "")
        + (a.AutoApproved > 0 ? $" · {a.AutoApproved} auto-approved" : "");
}
