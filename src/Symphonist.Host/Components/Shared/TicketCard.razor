@using System.Globalization
@using Symphonist.Core.Risk

@{
    var elapsed = ElapsedText();
    var progress = Card is { StageNumber: > 0, StageCount: > 0 };
    var footer = FooterItems(elapsed, progress).ToList();
}
<article class="card card-@(Card.Reviewing ? "reviewing" : Card.Status.ToString().ToLowerInvariant())" data-key="@Card.Key" data-project-card="@Card.Project">
    <div class="card-top">
        <a class="card-key" href="@DetailUrl">@Card.Key</a>
        <RiskBadge Risk="Card.Risk" />
        <span class="status-label"><span class="status-dot" aria-hidden="true"></span>@StatusText</span>
    </div>
    <p class="card-title">@Card.Title</p>
    @if (ProjectName is not null)
    {
        <p class="card-project">@ProjectName</p>
    }
    @if (progress)
    {
        <div class="card-progress" data-stage-progress>
            <div class="progress-row">
                <span>Stage @Card.StageNumber of @Card.StageCount</span>
                @if (elapsed is not null)
                {
                    <span>@elapsed</span>
                }
            </div>
            <div class="progress-track" aria-hidden="true">
                <div class="progress-fill" style="width: @ProgressPercent%"></div>
            </div>
        </div>
    }
    @if (Card.BlockedReason is { Length: > 0 } reason)
    {
        <p class="card-reason">@Truncate(reason)</p>
    }
    @if (footer.Count > 0 || Card.PrUrl is not null)
    {
        <p class="card-meta">
            @foreach (var item in footer)
            {
                <span>@item</span>
            }
            @if (Card.PrUrl is not null)
            {
                <a class="card-pr" href="@Card.PrUrl" target="_blank" rel="noopener noreferrer">PR</a>
            }
        </p>
    }
    @if (Card.WaitingOnYou && Card.Known)
    {
        <button type="button" class="button button-primary" disabled="@Approving" aria-busy="@(Approving ? "true" : null)"
                aria-label="@($"Approve {Card.Key}")" @onclick="OnApprove">Approve</button>
    }
</article>

@code {
    public const int ReasonLength = 140;

    [Parameter, EditorRequired] public BoardCard Card { get; set; } = default!;

    /// <summary>The time elapsed times are measured to.</summary>
    [Parameter, EditorRequired] public DateTimeOffset Now { get; set; }

    /// <summary>Shown on the all-projects board only.</summary>
    [Parameter] public string? ProjectName { get; set; }

    [Parameter] public bool Approving { get; set; }

    [Parameter] public EventCallback OnApprove { get; set; }

    private string DetailUrl => $"/tickets/{Uri.EscapeDataString(Card.Project)}/{Uri.EscapeDataString(Card.Key)}";

    private int ProgressPercent => (int)Math.Round(100.0 * Card.StageNumber!.Value / Card.StageCount!.Value, MidpointRounding.AwayFromZero);

    private string StatusText => StatusLabel(Card);

    /// <summary>The card's status; "Reviewing" while an active auto gate is still with the reviewer.</summary>
    public static string StatusLabel(BoardCard card) => card.Reviewing ? "Reviewing" : StatusLabel(card.Status);

    public static string StatusLabel(StageStatus status) => status switch
    {
        StageStatus.AwaitingApproval => "Waiting on you",
        StageStatus.Running => "Running",
        StageStatus.Blocked => "Blocked",
        StageStatus.Approved => "Approved",
        StageStatus.Done => "Done",
        _ => "Pending",
    };

    private string? ElapsedText() =>
        Card.Since is { } since && TimeVerb(Card) is { } verb ? $"{verb} {Elapsed(Now - since)}" : null;

    /// <summary>The footer line; the elapsed text moves here when there is no progress row to carry it.</summary>
    private IEnumerable<string> FooterItems(string? elapsed, bool progress)
    {
        if (Card.Attempts > 0)
            yield return Card.MaxAttempts is { } max ? $"attempt {Card.Attempts}/{max}" : $"attempt {Card.Attempts}";
        if (!progress && elapsed is not null) yield return elapsed;
        if (Card.CostUsd is { } cost) yield return "$" + cost.ToString("0.00", CultureInfo.InvariantCulture);
    }

    /// <summary>What the elapsed time measures ("running", "waiting", …); null when the status has no clock.</summary>
    public static string? TimeVerb(BoardCard card) => card.Status switch
    {
        StageStatus.Running => "running",
        StageStatus.AwaitingApproval => card.Reviewing ? "reviewing" : "waiting",
        StageStatus.Blocked => "blocked",
        _ => null,
    };

    /// <summary><c>4m</c>, <c>2h 5m</c>, <c>3d</c>.</summary>
    public static string Elapsed(TimeSpan span)
    {
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h {span.Minutes}m";
        return $"{(int)span.TotalDays}d";
    }

    private static string Truncate(string text) => text.Length <= ReasonLength ? text : text[..ReasonLength] + "…";
}
