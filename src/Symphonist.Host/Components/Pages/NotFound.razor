@page "/not-found"
@inject DashboardChrome Chrome

<div class="page-head">
    <h1 class="page-title">Not found</h1>
</div>
<p>There is nothing at this address. <a href="/">Go to the board</a></p>

@code {
    protected override void OnInitialized()
    {
        Chrome.ClearForNavigation(); // the previous page's message and errors
        Chrome.SetPage("Not found", null); // the layout's tab title shows it; no project is highlighted
    }
}
