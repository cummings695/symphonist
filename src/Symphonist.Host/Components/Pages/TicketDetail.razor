@page "/tickets/{Project}/{Key}"
@using System.Globalization
@using Microsoft.AspNetCore.Http
@using Symphonist.Core.Risk
@using Symphonist.Core.Storage
@implements IAsyncDisposable
@inject BoardQuery Query
@inject BoardNotifier Notifier
@inject Orchestrator Orchestrator
@inject DashboardChrome Chrome
@inject TimeProvider Time
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<TicketDetail> Log

@{
    var card = model?.Card;
}
<nav class="crumbs" aria-label="Breadcrumb">
    <a href="@($"/?project={Uri.EscapeDataString(Project)}")">@(model?.ProjectName ?? Project)</a>
    <span class="crumb-sep" aria-hidden="true">/</span>
    <span aria-current="page">@Key</span>
</nav>

@* Exactly one page <h1>, always this element, so the focus FocusOnNavigate gives it survives every load; only its
   text changes (the key while loading, then the title, or "Not found"). *@
<section class="summary @SummaryClass" aria-label="Summary" data-ticket-loaded="@(model is not null)">
    @if (card is not null)
    {
        <div class="facts">
            <span class="ticket-key">@card.Key</span>
            <span class="badge">@card.Source</span>
            <span class="ticket-status ticket-@StatusClass(card)" data-status><span class="status-dot" aria-hidden="true"></span>@TicketCard.StatusLabel(card)</span>
            <RiskBadge Risk="card.Risk" />
            @if (card.EvidenceIssues)
            {
                <span class="badge evidence-issues" data-evidence-issues>Evidence: issues found</span>
            }
            <span class="facts-numbers">
                @if (!model!.Pipeline.Any(s => s.Id == card.StageId))
                {
                    <span>stage <strong>@card.StageId</strong></span>
                }
                <span>attempt <strong>@(card.MaxAttempts is { } max ? $"{card.Attempts}/{max}" : card.Attempts.ToString(CultureInfo.InvariantCulture))</strong></span>
                @if (card.CostUsd is { } cost)
                {
                    <span>cost <strong>$@cost.ToString("0.00", CultureInfo.InvariantCulture)</strong></span>
                }
                @if (card.Since is { } since && TicketCard.TimeVerb(card) is { } verb)
                {
                    <span>@verb <strong>@TicketCard.Elapsed(Time.GetUtcNow() - since)</strong></span>
                }
            </span>
        </div>
    }
    <h1>@(notFound ? "Not found" : card?.Title ?? Key)</h1>
    @if (notFound)
    {
        <p>Ticket @Key was not found in project @Project.</p>
    }
    else if (model is null)
    {
        @if (ticketError is null)
        {
            <p class="loading">Loading the ticket…</p>
        }
    }
    else
    {
        @if (model.Pipeline.Count > 0)
        {
            <StageStepper Pipeline="model.Pipeline" CurrentStageId="@card!.StageId" Status="card.Status" WaitingOnYou="card.WaitingOnYou" />
        }
        @if (card!.BlockedReason is { Length: > 0 } reason)
        {
            <p class="ticket-reason" data-blocked-reason><strong>Blocked:</strong> @reason</p>
        }
        @if (model.Feedback is { Length: > 0 } feedbackText)
        {
            <p class="ticket-feedback" data-feedback><strong>Last feedback:</strong> @feedbackText</p>
        }
    }
</section>

@if (model is not null && card is not null)
{
    <div class="detail-grid">
        <div class="detail-history">
            <section class="panel" aria-labelledby="reviews-heading">
                <h2 id="reviews-heading">Gate reviews</h2>
                @if (model.Reviews.Count == 0)
                {
                    <p class="empty">No gate reviews yet.</p>
                }
                else
                {
                    <ol class="reviews">
                        @foreach (var review in model.Reviews)
                        {
                            <li class="review" data-gate-review>
                                <p class="review-head">
                                    <strong>@review.StageId</strong>
                                    <time datetime="@review.At.ToString("O", CultureInfo.InvariantCulture)">@LocalTime(review.At)</time>
                                    <span class="badge">@review.Mode.ToString().ToLowerInvariant()</span>
                                    <RiskBadge Risk="review.Verdict.Risk" />
                                    <span class="review-outcome">@Outcome(review)</span>
                                </p>
                                <p class="review-summary">@review.Verdict.Summary</p>
                                @if (review.Verdict.Error is { Length: > 0 } error)
                                {
                                    <p class="review-error" data-review-error><strong>Error:</strong> @error</p>
                                }
                                <ReviewList Title="Reasons" Items="review.Verdict.Reasons" Marker="data-reasons" />
                                <ReviewList Title="Checked" Items="review.Verdict.Checked" Marker="data-checked" />
                                <ReviewList Title="Risk areas touched" Items="review.Verdict.AreasTouched" Marker="data-areas" />
                            </li>
                        }
                    </ol>
                }
            </section>

            <EvidencePanel Records="model.Evidence" Project="@Project" Key="@Key" Known="card.Known" />

            <section class="panel" aria-labelledby="runs-heading">
                <h2 id="runs-heading">Agent runs</h2>
                @if (model.Runs.Count == 0)
                {
                    <p class="empty">No agent runs yet.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="runs">
                            <thead>
                                <tr><th>Stage</th><th>Started</th><th>Duration</th><th>Result</th><th>Cost</th><th>Summary or error</th><th>Log</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var run in model.Runs)
                                {
                                    <tr data-run>
                                        <td>@run.StageId</td>
                                        <td>@LocalTime(run.StartedAt)</td>
                                        <td>@Duration(run.Duration)</td>
                                        <td class="@(run.Succeeded ? "run-ok" : "run-failed")">@(run.Succeeded ? "succeeded" : "failed")</td>
                                        <td>@(run.CostUsd is { } c ? "$" + c.ToString("0.00", CultureInfo.InvariantCulture) : "")</td>
                                        <td class="run-text">@(run.Succeeded ? run.Summary : run.Error ?? run.Summary)</td>
                                        <td class="run-log">
                                            <code>@run.RawLogPath</code>
                                            <button type="button" class="button button-quiet" aria-label="@($"Copy path of the {run.StageId} log")"
                                                    @onclick="() => CopyPathAsync(run.RawLogPath)">Copy path</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="panel" aria-labelledby="events-heading">
                <h2 id="events-heading">Events</h2>
                @if (model.Events.Count == 0)
                {
                    <p class="empty">No events yet.</p>
                }
                else
                {
                    <ol class="events">
                        @foreach (var e in model.Events)
                        {
                            <li data-event>
                                <time datetime="@e.At.ToString("O", CultureInfo.InvariantCulture)">@LocalTime(e.At)</time>
                                <span class="event-stage">@e.StageId</span>
                                <span class="event-message">@e.Message</span>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>

        <aside class="detail-rail" aria-label="Actions and links">
            @if (model.CanApprove || model.CanUnblock || model.CanSendBack)
            {
                <section class="panel ticket-actions" aria-labelledby="actions-heading">
                    <h2 id="actions-heading">Actions</h2>
                    @if (model.CanApprove || model.CanUnblock)
                    {
                        <div class="action-row">
                            @if (model.CanApprove)
                            {
                                <button type="button" class="button button-primary" disabled="@busy" aria-busy="@(busy ? "true" : null)"
                                        @onclick="ApproveAsync">Approve</button>
                            }
                            @if (model.CanUnblock)
                            {
                                <button type="button" class="button" disabled="@busy" aria-busy="@(busy ? "true" : null)"
                                        @onclick="UnblockAsync">Unblock</button>
                            }
                        </div>
                    }
                    @if (model.CanSendBack)
                    {
                        <div class="send-back">
                            <label for="send-back-feedback">Send back with feedback</label>
                            <textarea id="send-back-feedback" rows="3" required @bind="feedback" @bind:event="oninput"></textarea>
                            <div class="action-row">
                                <label class="target">
                                    <span>Stage</span>
                                    <select @bind="sendBackTarget">
                                        @foreach (var target in model.SendBackTargets)
                                        {
                                            <option value="@target">@target</option>
                                        }
                                    </select>
                                </label>
                                <button type="button" class="button" disabled="@(busy || string.IsNullOrWhiteSpace(feedback))"
                                        aria-busy="@(busy ? "true" : null)" @onclick="SendBackAsync">Send back</button>
                            </div>
                        </div>
                    }
                </section>
            }

            <section class="panel ticket-links" aria-labelledby="links-heading">
                <h2 id="links-heading">Links</h2>
                @if (card.IssueUrl is null && card.PrUrl is null && model.ReleasePrUrl is null && string.IsNullOrEmpty(model.Branch)
                     && string.IsNullOrEmpty(model.SpecPath) && string.IsNullOrEmpty(model.PlanPath))
                {
                    <p class="empty">No links yet.</p>
                }
                @if (card.IssueUrl is not null)
                {
                    <a href="@card.IssueUrl" target="_blank" rel="noopener noreferrer">Tracker issue<span aria-hidden="true"> ↗</span></a>
                }
                @if (card.PrUrl is not null)
                {
                    <a href="@card.PrUrl" target="_blank" rel="noopener noreferrer">Pull request<span aria-hidden="true"> ↗</span></a>
                }
                @if (model.ReleasePrUrl is not null)
                {
                    <a href="@model.ReleasePrUrl" target="_blank" rel="noopener noreferrer">Release pull request<span aria-hidden="true"> ↗</span></a>
                }
                @if (model.Branch is { Length: > 0 } branch)
                {
                    <div><span class="link-label">Branch</span> <code>@branch</code></div>
                }
                @if (model.SpecPath is { Length: > 0 } spec)
                {
                    <div><span class="link-label">Spec</span> <a href="@DocHref("spec")" class="doc-link" data-spec-link><code>@spec</code></a></div>
                }
                @if (model.PlanPath is { Length: > 0 } plan)
                {
                    <div><span class="link-label">Plan</span> <a href="@DocHref("plan")" class="doc-link" data-plan-link><code>@plan</code></a></div>
                }
            </section>
        </aside>
    </div>
}

@code {
    private readonly CancellationTokenSource disposed = new();
    private TicketDetailModel? model;
    private bool notFound;
    private string? ticketError; // the last load's error, also reported to the status line
    private bool busy;
    private int loadVersion;
    private string? loadedFor;
    private string feedback = "";
    private string? sendBackTarget;
    private IJSObjectReference? clipboard;

    [Parameter] public string Project { get; set; } = "";

    [Parameter] public string Key { get; set; } = "";

    /// <summary>Set while prerendering, so a missing ticket answers 404 with the not-found page.</summary>
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>The summary panel's rail: ochre when waiting on you, red when blocked, none otherwise.</summary>
    private string SummaryClass =>
        notFound ? "not-found"
        : model?.Card is not { } card ? ""
        : card.WaitingOnYou ? "summary-waiting"
        : card.Status == StageStatus.Blocked ? "summary-blocked"
        : "";

    /// <summary>The page that renders the ticket's stored spec or plan (the path itself is never put in the address).</summary>
    private string DocHref(string kind) => $"/tickets/{Uri.EscapeDataString(Project)}/{Uri.EscapeDataString(Key)}/docs/{kind}";

    protected override void OnInitialized() => Notifier.Changed += OnTicketChanged;

    protected override async Task OnParametersSetAsync()
    {
        var current = $"{Project}/{Key}";
        if (loadedFor == current) return;
        loadedFor = current;
        model = null;
        notFound = false;
        ticketError = null;
        Chrome.ClearForNavigation(); // the previous page's (or ticket's) message and errors
        Chrome.SetPage(Key, Project);
        await ReloadAsync();
        // While prerendering, answer 404 with the not-found page (a bare status would reach the browser with no body).
        if (notFound && HttpContext is { Response.HasStarted: false }) Navigation.NotFound();
    }

    private void OnTicketChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    /// <summary>Loads the ticket; a failure keeps the last model and reports the error in the status line.</summary>
    private async Task ReloadAsync()
    {
        var version = ++loadVersion;
        try
        {
            var loaded = await Query.LoadTicketAsync(Project, Key, disposed.Token);
            if (disposed.IsCancellationRequested || version != loadVersion) return; // gone, or a newer load started meanwhile
            model = loaded;
            notFound = loaded is null;
            ticketError = null;
            Chrome.SetError(StatusSource.Ticket, null);
            if (loaded is not null && (sendBackTarget is null || !loaded.SendBackTargets.Contains(sendBackTarget)))
                sendBackTarget = loaded.SendBackTargets.FirstOrDefault();
        }
        catch (OperationCanceledException) when (disposed.IsCancellationRequested)
        {
            // Disposed.
        }
        catch (Exception e)
        {
            if (disposed.IsCancellationRequested || version != loadVersion) return;
            ticketError = $"Could not refresh the ticket: {e.Message}";
            Chrome.SetError(StatusSource.Ticket, ticketError);
        }
    }

    private Task ApproveAsync()
    {
        var stage = model?.Card.StageId; // the gate and round shown on the page, not ones the ticket reached meanwhile
        var round = model?.Card.Since;
        return RunAsync("approve", "approved", ct => Orchestrator.ApproveAsync(Project, Key, ct, stage, round));
    }

    private Task UnblockAsync() =>
        RunAsync("unblock", "unblocked", ct => Orchestrator.UnblockAsync(Project, Key, ct));

    private async Task SendBackAsync()
    {
        var text = feedback.Trim();
        if (text.Length == 0) return;
        var target = sendBackTarget;
        if (await RunAsync("send back", "sent back", ct => Orchestrator.SendBackAsync(Project, Key, text, target, ct)))
            feedback = "";
    }

    /// <summary>Runs one command and reloads; every failure is shown in the status line and cannot reach the circuit.</summary>
    /// <returns>True when the command was applied.</returns>
    private async Task<bool> RunAsync(string verb, string pastTense, Func<CancellationToken, Task<TransitionOutcome>> command)
    {
        if (busy || model is null) return false;
        busy = true;
        var before = (model.Card.StageId, model.Card.Status);
        Exception? failure = null;
        var applied = false;
        try
        {
            var outcome = await command(disposed.Token);
            if (disposed.IsCancellationRequested) return false; // the next page owns the frame now
            Chrome.ShowMessage($"{Key}: {outcome.Message}");
            applied = outcome.Changed;
        }
        catch (OperationCanceledException) when (disposed.IsCancellationRequested)
        {
            return false;
        }
        catch (KeyNotFoundException e)
        {
            if (disposed.IsCancellationRequested) return false;
            Chrome.ShowMessage(e.Message); // e.g. the ticket, its project or the target stage was removed meanwhile
        }
        catch (Exception e)
        {
            Log.LogError(e, "Command '{Verb}' on {Project}/{Key} from the dashboard failed", verb, Project, Key);
            failure = e;
        }
        finally
        {
            busy = false;
        }
        await ReloadAsync();
        if (disposed.IsCancellationRequested) return false;

        // The orchestrator stores the change before recording and syncing it, so a failure (e.g. of the store) may
        // come after the ticket has already moved: word the message from the ticket's state as reloaded.
        if (failure is not null)
        {
            var moved = ticketError is null && model is { } now && (now.Card.StageId, now.Card.Status) != before;
            Chrome.ShowMessage(moved
                ? $"{Key}: {pastTense}, but a follow-up step failed: {failure.Message}"
                : $"{Key}: {verb} failed: {failure.Message}");
            applied = moved;
        }
        return applied;
    }

    private async Task CopyPathAsync(string path)
    {
        try
        {
            clipboard ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
            var copied = await clipboard.InvokeAsync<bool>("copyText", path);
            if (disposed.IsCancellationRequested) return; // the next page owns the frame now
            Chrome.ShowMessage(copied ? "Copied the log path" : "Could not copy the log path");
        }
        catch (Exception e)
        {
            // Copying is a convenience: nothing here may reach the circuit (timeouts, disposed module, disconnects).
            Log.LogWarning(e, "Copying a log path from the dashboard failed");
            if (!disposed.IsCancellationRequested) Chrome.ShowMessage("Could not copy the log path");
        }
    }

    /// <summary>The status pill's colour class; "reviewing" stays neutral, as only waiting on you is ochre.</summary>
    private static string StatusClass(BoardCard card) =>
        card.Reviewing ? "reviewing" : card.Status.ToString().ToLowerInvariant();

    private static string LocalTime(DateTimeOffset at) =>
        at.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);

    private static string Outcome(GateReview review) =>
        review.AutoDecided ? "auto-approved"
        : review.Decision switch
        {
            GateDecision.Approved => "you approved",
            GateDecision.SentBack => "you sent back",
            _ => "undecided",
        };

    private static string Duration(TimeSpan span) =>
        span.TotalMinutes < 1 ? $"{(int)span.TotalSeconds}s" : $"{(int)span.TotalMinutes}m {span.Seconds:00}s";

    public async ValueTask DisposeAsync()
    {
        Notifier.Changed -= OnTicketChanged;
        disposed.Cancel();
        if (clipboard is not null)
        {
            try
            {
                await clipboard.DisposeAsync();
            }
            catch (Exception e) when (e is JSDisconnectedException or JSException)
            {
                // The circuit is already gone.
            }
        }
    }
}
