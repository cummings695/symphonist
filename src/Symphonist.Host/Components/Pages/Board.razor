@page "/"
@implements IAsyncDisposable
@inject BoardQuery Query
@inject BoardNotifier Notifier
@inject Orchestrator Orchestrator
@inject ProjectRegistry Registry
@inject TimeProvider Time
@inject DashboardChrome Chrome
@inject IJSRuntime JS
@inject ILogger<Board> Log

@* Exactly one page <h1>, always this element, so the focus FocusOnNavigate gives it survives every load; only its
   text changes. The name comes from any loaded board (all projects are listed); an unknown id loads the
   all-projects board, and until the first load the id stands in for the name. *@
@{
    var filtered = model?.Projects.FirstOrDefault(p => p.Id == model.ProjectFilter);
    var heading = model?.Projects.FirstOrDefault(p => p.Id == Project)?.Name
        ?? (model is null && !string.IsNullOrEmpty(Project) ? Project : "All projects");
}
<div class="page-head">
    <h1 class="page-title">@heading</h1>
    @* Only the project the heading names: during a switch the last board is still the previous project's. *@
    @if (filtered is not null && filtered.Id == Project)
    {
        <ProjectHeading Project="filtered" OnTogglePause="() => TogglePause(filtered)" />
    }
    <div class="page-head-action">
        <a class="button button-quiet" href="/projects/new">Add project</a>
        <button type="button" class="button button-quiet" disabled="@reloading" @onclick="ReloadProjectsAsync">Reload projects</button>
    </div>
</div>

@if (Registry.LoadErrors.Count > 0)
{
    <div class="board-problems" role="status">
        @foreach (var (file, message) in Registry.LoadErrors.OrderBy(e => e.Key, StringComparer.Ordinal))
        {
            <p class="project-problem" data-load-error="@file">@file skipped: @message</p>
        }
    </div>
}

@if (model is null)
{
    @if (boardError is null)
    {
        <p class="loading">Loading the board…</p>
    }
}
else
{
    <div data-board-loaded>
        @if (model.Projects.Count == 0)
        {
            <section class="setup-hint">
                <h2>No projects configured</h2>
                <p>Use <a href="/projects/new">Add project</a>, or add a project file (<code>*.yaml</code>) to <code>@SymphonistPaths.Resolve("projects")</code> and use Reload projects.</p>
            </section>
        }
        else if (filtered is null && model.Projects.Any(p => p.Problem is { Length: > 0 }))
        {
            <div class="board-problems">
                @foreach (var p in model.Projects.Where(p => p.Problem is { Length: > 0 }))
                {
                    <p class="project-problem" data-problem="@p.Id"><strong>@p.Name:</strong> @p.Problem</p>
                }
            </div>
        }

        @if (model.Columns.Count > 0)
        {
            <div class="columns" role="list" aria-label="Pipeline">
                @foreach (var column in model.Columns)
                {
                    var total = column.Cards.Count + column.HiddenCount;
                    // At phone width an empty stage is only its header line already, so only stages with tickets fold there.
                    var foldable = total > 0 || phone == false;
                    var folded = foldable && IsFolded(column);
                    var waiting = column.Cards.Count(c => c.WaitingOnYou);
                    <section class="column @(column.Kind is { } kind ? $"lane-{kind.ToString().ToLowerInvariant()}" : null) @(column.Id == BoardQuery.UnknownColumnId ? "column-unknown" : null) @(folded ? "collapsed" : null)"
                             role="listitem" data-column="@column.Id" aria-labelledby="col-@column.Id">
                        <h2 class="column-header" id="col-@column.Id">
                            @if (foldable)
                            {
                                @* Folds the stage to its header line at phone width, and to a narrow upright strip on a desktop. *@
                                <button type="button" class="column-toggle" aria-expanded="@(folded ? "false" : "true")"
                                        aria-controls="cards-@column.Id" @onclick="() => ToggleAsync(column)">
                                    <span class="column-mark" aria-hidden="true"></span>
                                    <span class="column-title">@column.Title</span>
                                    <span class="column-meta">
                                        @if (folded && waiting > 0)
                                        {
                                            <span class="column-waiting count-waiting">@waiting waiting</span>
                                        }
                                        <span class="column-count" aria-label="@($"{total} tickets")">@total</span>
                                        <span class="column-chevron" aria-hidden="true"></span>
                                    </span>
                                </button>
                            }
                            else
                            {
                                <span class="column-mark" aria-hidden="true"></span>
                                <span class="column-title">@column.Title</span>
                                <span class="column-count" aria-label="@($"{total} tickets")">@total</span>
                            }
                        </h2>
                        <div class="column-cards" id="cards-@column.Id">
                            @foreach (var card in column.Cards)
                            {
                                <TicketCard @key="(card.Project, card.Key)" Card="card" Now="now"
                                            ProjectName="@(model.ProjectFilter is null ? ProjectName(card.Project) : null)"
                                            Approving="approving.Contains((card.Project, card.Key))"
                                            OnApprove="() => ApproveAsync(card)" />
                            }
                            @if (column.Cards.Count == 0 && column.HiddenCount == 0)
                            {
                                <p class="column-empty">No tickets</p>
                            }
                            @if (column.HiddenCount > 0)
                            {
                                <p class="column-more">+@column.HiddenCount older</p>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </div>
}

@code {
    private static readonly TimeSpan ElapsedRefresh = TimeSpan.FromSeconds(30);

    private readonly HashSet<(string Project, string Key)> approving = [];
    private readonly CancellationTokenSource disposed = new();
    private BoardModel? model;
    private string? boardError; // the last load's error, also reported to the status line
    private DateTimeOffset now;
    private int loadVersion;
    private string? loadedFilter;
    private PeriodicTimer? clock;
    private readonly Dictionary<string, bool> foldChoices = [];
    private readonly HashSet<string> openedWhileEmpty = [];
    private IJSObjectReference? folds;
    private DotNetObjectReference<Board>? self;
    private bool? phone; // unknown until the browser says; the CSS decides meanwhile
    private bool reloading;

    [SupplyParameterFromQuery(Name = "project")]
    public string? Project { get; set; }

    protected override void OnInitialized()
    {
        now = Time.GetUtcNow();
        Chrome.ClearForNavigation(); // the previous page's message and errors
        Notifier.Changed += OnBoardChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (model is not null && loadedFilter == Project) return;
        loadedFilter = Project;
        Chrome.SetPage(null, Project); // the frame shows the board now; the load corrects an unknown id to All projects
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ = TickClockAsync();
        await LoadFoldsAsync();
    }

    /// <summary>
    /// A stage's folded state. Done follows the developer's choice in this browser (folded until they choose). Any other
    /// stage is folded while it has no tickets (opening it then lasts only for this page), and follows the developer's
    /// choice, else open, once it has some.
    /// </summary>
    private bool IsFolded(BoardColumn column)
    {
        if (column.IsDone) return foldChoices.TryGetValue(column.Id, out var done) ? done : true;
        if (IsEmpty(column)) return !openedWhileEmpty.Contains(column.Id);
        return foldChoices.TryGetValue(column.Id, out var folded) && folded;
    }

    private static bool IsEmpty(BoardColumn column) => column.Cards.Count + column.HiddenCount == 0;

    /// <summary>Applies the folds stored in this browser and learns whether it is at phone width.</summary>
    private async Task LoadFoldsAsync()
    {
        try
        {
            folds ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/board-folds.js");
            var stored = await folds.InvokeAsync<Dictionary<string, bool>?>("load");
            foreach (var (id, folded) in stored ?? [])
                foldChoices.TryAdd(id, folded); // a tap made meanwhile wins
            self ??= DotNetObjectReference.Create(this);
            phone = await folds.InvokeAsync<bool>("watchPhone", self);
        }
        catch (Exception e)
        {
            // Folding is a convenience: storage or JS failures (and disconnects) must never reach the circuit.
            Log.LogDebug(e, "Loading the folded board stages failed");
        }
        StateHasChanged();
    }

    /// <summary>Called by the browser when the board crosses the phone-width breakpoint.</summary>
    [JSInvokable]
    public Task SetPhone(bool matches) => InvokeAsync(() =>
    {
        phone = matches;
        StateHasChanged();
    });

    private async Task ToggleAsync(BoardColumn column)
    {
        if (!column.IsDone && IsEmpty(column))
        {
            // An empty stage folds again on the next visit; the stored choice is kept for when it has tickets.
            if (!openedWhileEmpty.Remove(column.Id)) openedWhileEmpty.Add(column.Id);
            return;
        }
        foldChoices[column.Id] = !IsFolded(column);
        try
        {
            if (folds is not null) await folds.InvokeAsync<bool>("save", foldChoices);
        }
        catch (Exception e)
        {
            Log.LogDebug(e, "Storing the folded board stages failed");
        }
    }

    /// <summary>Re-renders elapsed times only; the board itself reloads on <see cref="BoardNotifier.Changed"/>.</summary>
    private async Task TickClockAsync()
    {
        clock = new PeriodicTimer(ElapsedRefresh, Time);
        try
        {
            while (await clock.WaitForNextTickAsync(disposed.Token))
                await InvokeAsync(() =>
                {
                    now = Time.GetUtcNow();
                    StateHasChanged();
                });
        }
        catch (OperationCanceledException)
        {
            // Disposed.
        }
    }

    private void OnBoardChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    /// <summary>Loads the board; a failure keeps the last board and reports the error in the layout's status line.</summary>
    private async Task ReloadAsync()
    {
        var version = ++loadVersion;
        try
        {
            var board = await Query.LoadBoardAsync(Project, disposed.Token);
            if (disposed.IsCancellationRequested || version != loadVersion) return; // gone, or a newer load started meanwhile
            model = board;
            boardError = null;
            Chrome.SetPage(null, board.ProjectFilter);
            Chrome.SetError(StatusSource.Board, null);
        }
        catch (OperationCanceledException) when (disposed.IsCancellationRequested)
        {
            // Disposed.
        }
        catch (Exception e)
        {
            if (!disposed.IsCancellationRequested && version == loadVersion)
            {
                boardError = $"Could not refresh the board: {e.Message}";
                Chrome.SetError(StatusSource.Board, boardError);
            }
        }
        now = Time.GetUtcNow();
    }

    private async Task TogglePause(BoardProject p)
    {
        try
        {
            Registry.SetPaused(p.Id, !p.Paused);
            Chrome.ShowMessage(p.Paused ? $"{p.Name} resumed" : $"{p.Name} paused");
        }
        catch (Exception e)
        {
            // E.g. paused.json cannot be written: report it rather than kill the circuit.
            Log.LogError(e, "{Action} {Project} from the dashboard failed", p.Paused ? "Resuming" : "Pausing", p.Id);
            Chrome.ShowMessage($"Could not {(p.Paused ? "resume" : "pause")} {p.Name}: {e.Message}");
        }
        await ReloadAsync();
    }

    /// <summary>Reloads the project files (after a hand edit); the skipped files show as banners above the board.</summary>
    private async Task ReloadProjectsAsync()
    {
        if (reloading) return;
        reloading = true;
        try
        {
            var reload = await Orchestrator.ReloadProjectsAsync(disposed.Token);
            if (disposed.IsCancellationRequested) return;
            Chrome.ShowMessage(reload.Errors.Count == 0
                ? $"Reloaded {reload.ProjectIds.Count} project(s)"
                : $"{reload.Errors.Count} project file(s) skipped");
        }
        catch (OperationCanceledException) when (disposed.IsCancellationRequested)
        {
            return;
        }
        catch (Exception e)
        {
            Log.LogError(e, "Reloading the projects from the dashboard failed");
            Chrome.ShowMessage($"Could not reload the projects: {e.Message}");
        }
        finally
        {
            reloading = false;
        }
        await ReloadAsync();
    }

    private async Task ApproveAsync(BoardCard card)
    {
        var id = (card.Project, card.Key);
        if (!approving.Add(id)) return;
        Exception? failure = null;
        try
        {
            var outcome = await Orchestrator.ApproveAsync(card.Project, card.Key, disposed.Token, card.StageId, card.Since);
            if (disposed.IsCancellationRequested) return; // the next page owns the frame now
            Chrome.ShowMessage($"{card.Key}: {outcome.Message}");
        }
        catch (OperationCanceledException) when (disposed.IsCancellationRequested)
        {
            return;
        }
        catch (KeyNotFoundException e)
        {
            if (disposed.IsCancellationRequested) return;
            Chrome.ShowMessage(e.Message); // e.g. the ticket or its project was removed meanwhile
        }
        catch (Exception e)
        {
            Log.LogError(e, "Approving {Project}/{Key} from the dashboard failed", card.Project, card.Key);
            failure = e;
        }
        finally
        {
            approving.Remove(id);
        }
        await ReloadAsync();
        if (disposed.IsCancellationRequested) return;

        // The orchestrator stores the approval before recording and syncing it, so a failure (e.g. of the store) may
        // come after the ticket has already moved on: word the message from the ticket's state as reloaded.
        if (failure is not null)
            Chrome.ShowMessage(StillWaiting(card)
                ? $"{card.Key}: approve failed: {failure.Message}"
                : $"{card.Key}: approved, but a follow-up step failed: {failure.Message}");
    }

    /// <summary>True when the reloaded board still shows the card awaiting approval (or could not be reloaded).</summary>
    private bool StillWaiting(BoardCard card) =>
        boardError is not null || model?.Columns.SelectMany(c => c.Cards)
            .FirstOrDefault(c => c.Project == card.Project && c.Key == card.Key) is not { WaitingOnYou: false };

    private string ProjectName(string id) => model?.Projects.FirstOrDefault(p => p.Id == id)?.Name ?? id;

    public async ValueTask DisposeAsync()
    {
        Notifier.Changed -= OnBoardChanged;
        disposed.Cancel();
        clock?.Dispose();
        self?.Dispose(); // the browser's breakpoint listener removes itself on its next failed call
        if (folds is not null)
        {
            try
            {
                await folds.DisposeAsync();
            }
            catch (Exception e)
            {
                Log.LogDebug(e, "Releasing the board folds module failed"); // e.g. the circuit is already gone
            }
        }
    }
}
